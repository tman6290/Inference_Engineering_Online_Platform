# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://forwardpass:forwardpass@localhost:5433/forwardpass
# Integration tests. The API test setup creates and migrates this database.
DATABASE_URL_TEST=postgresql://forwardpass:forwardpass@localhost:5433/forwardpass_test

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Used for project critiques only. anthropic | openai-compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# openai-compatible only, e.g. http://localhost:8000/v1
LLM_BASE_URL=
LLM_MODEL=
# Optional: USD per million tokens, used for the cost line in the LLM call log
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Two seats, one code each
INVITE_CODE_1=
INVITE_CODE_2=

APP_URL=http://localhost:5173
API_PORT=4000
RUNNER_URL=http://localhost:4100
# Shared secret between the API and the runner (openssl rand -hex 32). Without it, project checks are off.
RUNNER_TOKEN=
# Where the runner finds the API. From inside docker compose, use http://host.docker.internal:4000.
RUNNER_API_URL=http://localhost:4000
# Only when the runner itself runs in docker compose: the absolute host path of ./runner-jobs,
# so the sandbox containers it starts can mount job folders.
RUNNER_HOST_JOBS_DIR=
TZ=Africa/Lagos
