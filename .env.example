# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://forwardpass:forwardpass@localhost:5432/forwardpass

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# anthropic | openai-compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# openai-compatible only, e.g. http://localhost:8000/v1
LLM_BASE_URL=
LLM_MODEL=
# Optional: USD per million tokens, used for the cost line in the LLM call log
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Two seats, one code each
INVITE_CODE_1=
INVITE_CODE_2=

APP_URL=http://localhost:5173
API_PORT=4000
RUNNER_URL=http://localhost:4100
TZ=Africa/Lagos
