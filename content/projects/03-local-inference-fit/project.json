                },
                "p95": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "peak_memory_gb": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "sustained": {
        "type": "object",
        "required": ["model", "minutes", "decode_tps_start", "decode_tps_end"],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "number",
            "minimum": 10
          },
          "decode_tps_start": {
            "type": "number",
            "exclusiveMinimum": 0
