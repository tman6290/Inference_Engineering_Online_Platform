        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "min_decode_tps": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "models": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "name",
            "params_b",
            "file_gb",
            "requests",
            "predicted_decode_tps_ceiling",
            "decode_tps_p50",
            "prefill_tps_p50",
            "ttft_ms",
            "peak_memory_gb"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "params_b": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "file_gb": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "requests": {
              "type": "integer",
              "minimum": 30
            },
            "predicted_decode_tps_ceiling": {
              "type": "number",
              "exclusiveMinimum": 0
