// Models arrive with the features that need them. Authored content (digests, questions,
// exercises) stays in files under content/ and is referenced by id, never stored here.

generator client {
  provider = "prisma-client"
  // Kept under node_modules so generated code never lands in git.
  output   = "../node_modules/.prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum PodColour {
  lime
  butter
}

/// One of the pod's two seats.
model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  displayName        String
  initial            String
  colour             PodColour
  passwordHash       String
  /// Set when an admin creates the account or resets its password; cleared once the user picks their own.
  mustChangePassword Boolean     @default(false)
  /// The longest uptime streak so far, in days. Kept even after the study days that made it change.
  longestUptime      Int         @default(0)
  /// The address of the public portfolio, /p/<username>. Chosen by the learner; null until then.
  username           String?     @unique
  /// Whether the public profile and case studies are served at all. Off by default.
  pageLive           Boolean     @default(false)
  createdAt          DateTime    @default(now())
  sessions           Session[]
  inviteCode         InviteCode?
}

/// The id is an HMAC of the cookie token, so a leaked table can't be replayed as cookies.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// A row exists once a seat's code has been spent. The slot (1 or 2) maps to INVITE_CODE_1 / INVITE_CODE_2.
model InviteCode {
  slot     Int      @id
  codeHash String
  spentAt  DateTime @default(now())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// The book, filled by `pnpm content:ingest` from the published Markdown.
// Book text lives here and in content/book/ (gitignored), never in git.
// ---------------------------------------------------------------------------

/// Preface, appendices and acknowledgements: pages outside the numbered chapters.
model BookPage {
  slug       String @id
  title      String
  summary    String
  url        String
  markdown   String
  /// "front" (Preface) or "back" (appendices, acknowledgements).
  placement  String
  orderIndex Int
}

model Chapter {
  number   Int       @id
  slug     String    @unique
  title    String
  summary  String
  url      String
  /// The chapter's opening text, before its first numbered section.
  intro    String
  sections Section[]
  figures  Figure[]
}

model Section {
  number         String       @id
  chapterNumber  Int
  chapter        Chapter      @relation(fields: [chapterNumber], references: [number], onDelete: Cascade)
  slug           String
  title          String
  summary        String
  url            String
  /// Text before the first subsection.
  intro          String
  wordCount      Int
  readingMinutes Int
  orderIndex     Int          @unique
  /// Bold phrases in the text, a hint for glossary links.
  boldTerms      String[]
  subsections    Subsection[]
  figures        Figure[]
}

model Subsection {
  number        String   @id
  sectionNumber String
  section       Section  @relation(fields: [sectionNumber], references: [number], onDelete: Cascade)
  title         String
  markdown      String
  orderIndex    Int
  figures       Figure[]

  @@index([sectionNumber])
}

model Figure {
  number           String      @id
  caption          String
  sourceUrl        String
  /// File name inside content/figures, e.g. "5.3.png".
  fileName         String
  /// Set for chapter figures; null for the Preface's P.n figures, which use pageSlug.
  chapterNumber    Int?
  chapter          Chapter?    @relation(fields: [chapterNumber], references: [number], onDelete: Cascade)
  pageSlug         String?
  sectionNumber    String?
  section          Section?    @relation(fields: [sectionNumber], references: [number], onDelete: SetNull)
  subsectionNumber String?
  subsection       Subsection? @relation(fields: [subsectionNumber], references: [number], onDelete: SetNull)
}

model GlossaryTerm {
  slug          String  @id
  term          String
  definition    String
  /// First section whose text uses the term.
  sectionNumber String?
}

// ---------------------------------------------------------------------------
// Studying. Lesson ids are "preface", "0" or a section number like "5.2".
// ---------------------------------------------------------------------------

enum Confidence {
  shaky
  okay
  solid
}

/// One row per learner per lesson: how far they've scrolled and when it counted as read.
model LessonProgress {
  userId       String
  lessonId     String
  maxScrollPct Int       @default(0)
  readAt       DateTime?
  updatedAt    DateTime  @updatedAt

  @@id([userId, lessonId])
}

/// A stretch of reading, written at most every 30 seconds while the page is open.
model ReadingEvent {
  id           String   @id @default(uuid())
  userId       String
  lessonId     String
  startedAt    DateTime
  endedAt      DateTime
  maxScrollPct Int

  @@index([userId, lessonId])
}

/// Every rating is kept; the latest one is the learner's current confidence.
model ConfidenceRating {
  id        String     @id @default(uuid())
  userId    String
  lessonId  String
  level     Confidence
  createdAt DateTime   @default(now())

  @@index([userId, lessonId, createdAt])
}

/// A learner's notes on a lesson. Visible to their pod partner.
model Note {
  userId    String
  lessonId  String
  body      String
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
}

/// A graded answer. `context` is "check" (a lesson's check-yourself), "checkpoint" or "exercise".
/// For an exercise, `questionId` is the exercise id.
model Answer {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String
  questionId String
  context    String
  /// Set for checkpoint answers.
  attemptId  String?
  answer     Json
  accepted   Boolean
  /// The first submission for this question: in the attempt for a checkpoint, ever otherwise.
  firstTry   Boolean
  usedHint   Boolean  @default(false)
  feedback   String?
  createdAt  DateTime @default(now())

  @@index([userId, questionId])
  @@index([userId, lessonId])
  @@index([attemptId])
}

/// A 10-question checkpoint on one section. Question ids are fixed when it starts.
model Attempt {
  id               String    @id @default(uuid())
  userId           String
  sectionNumber    String
  /// Seeds the question draw, so the same seed and exclusions give the same questions.
  seed             String
  questionIds      String[]
  /// "solo" (one section), "recall" (spaced review) or "duel" once duels exist.
  kind             String    @default("solo")
  /// Every section a recall attempt covers; empty for a solo attempt, which uses sectionNumber.
  sectionNumbers   String[]  @default([])
  startedAt        DateTime  @default(now())
  // Filled when the attempt finishes.
  completedAt      DateTime?
  firstTryAccepted Int?
  hints            Int?
  passed           Boolean?

  @@index([userId, sectionNumber])
}

/// A hint asked for during an attempt. Logged, never hidden.
model AttemptHint {
  attemptId  String
  questionId String
  createdAt  DateTime @default(now())

  @@id([attemptId, questionId])
}

/// A learner opened an exercise's solution before getting it right.
model ExerciseReveal {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  @@id([userId, exerciseId])
}

/// One learner's study on one day in Africa/Lagos. Rebuilt from the raw activity above, so it can
/// always be thrown away and recomputed.
model StudyDay {
  userId         String
  /// YYYY-MM-DD in the pod's timezone.
  date           String
  readingMinutes Int
  sectionsRead   Int
  answersGraded  Int
  projectEvents  Int
  /// 0 is no study; 1 to 3 are the heatmap's steps.
  intensity      Int

  @@id([userId, date])
}

// ---------------------------------------------------------------------------
// Pod: duels and teach-backs. Projects never appear here; they stay individual.
// ---------------------------------------------------------------------------

/// Both learners take the same ten questions on one section, alone, within 48 hours.
model Duel {
  id                  String    @id @default(uuid())
  sectionNumber       String
  challengerId        String
  opponentId          String
  /// pending (sent), open (accepted), complete (both finished, resolved) or expired.
  status              String    @default("pending")
  /// Seeds the shared draw; the questions are fixed when the duel is created.
  seed                String
  questionIds         String[]
  createdAt           DateTime  @default(now())
  deadline            DateTime
  acceptedAt          DateTime?
  resolvedAt          DateTime?
  /// Null on a draw, or while unresolved.
  winnerId            String?
  challengerAttemptId String?
  opponentAttemptId   String?

  @@index([challengerId])
  @@index([opponentId])
}

/// The loser's explanation of the questions they missed: text per question, an audio file, or both.
model TeachBack {
  id        String   @id @default(uuid())
  duelId    String   @unique
  userId    String
  /// [{ questionId, text }] for the questions the author missed on the first try.
  entries   Json
  /// The recording's file name, when audio was recorded. Its bytes are in TeachBackAudio (older
  /// recordings may still be under uploads/teach-backs).
  audioFile String?
  audioMime String?
  createdAt DateTime        @default(now())
  audio     TeachBackAudio?
}

/// A teach-back recording's bytes, kept in the database so a host with a throwaway disk keeps them.
model TeachBackAudio {
  teachBackId String    @id
  teachBack   TeachBack @relation(fields: [teachBackId], references: [id], onDelete: Cascade)
  data        Bytes
}

// ---------------------------------------------------------------------------
// Projects: solo deliverables, graded by checks and then a critique. Specs live in
// content/projects/ and are copied here so submissions can reference them.
// ---------------------------------------------------------------------------

/// A copy of content/projects/<slug>/project.json and its brief, kept in sync at API start.
model Project {
  slug               String       @id
  number             Int          @unique
  title              String
  chapter            Int
  unlockAfterSection String
  spec               Json
  brief              String
  updatedAt          DateTime     @updatedAt
  submissions        Submission[]
}

/// One learner's attempt at a project. Versions count up per learner per project.
model Submission {
  id           String           @id @default(uuid())
  userId       String
  projectSlug  String
  project      Project          @relation(fields: [projectSlug], references: [slug])
  version      Int
  repoUrl      String
  /// As submitted, or the commit the runner cloned when none was given.
  commitSha    String?
  noteToGrader String?
  /// queued, checking, critiquing, graded or failed.
  status       String           @default("queued")
  /// Why a failed submission failed, in a sentence.
  failure      String?
  /// Shown as a public case study. Only a graded, portfolio-ready version; at most one per project.
  public       Boolean          @default(false)
  /// What the runner read from the repo for the critique: file tree, README, results, sources.
  artifacts    Json?
  createdAt    DateTime         @default(now())
  claimedAt    DateTime?
  gradedAt     DateTime?
  files        SubmissionFile[]
  checks       CheckResult[]
  critique     Critique?

  @@unique([userId, projectSlug, version])
  @@index([status, createdAt])
}

/// An upload beside the repo: a PDF, PNG, notebook or zip. Its bytes are in SubmissionFileBlob
/// (older uploads may still be under uploads/submissions).
model SubmissionFile {
  id           String              @id @default(uuid())
  submissionId String
  submission   Submission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  size         Int
  createdAt    DateTime            @default(now())
  blob         SubmissionFileBlob?

  @@unique([submissionId, name])
}

/// An upload's bytes, apart from SubmissionFile so listing files never loads them.
model SubmissionFileBlob {
  fileId String         @id
  file   SubmissionFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  data   Bytes
}

model CheckResult {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  checkId      String
  kind         String
  passed       Boolean
  /// Capped at 200 KB.
  log          String
  durationMs   Int
  /// Order in the spec.
  position     Int

  @@unique([submissionId, checkId])
}

/// The one runtime model call: a structured critique of a checked submission.
model Critique {
  id           String     @id @default(uuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  json         Json
  model        String
  costUsd      Float?
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime   @default(now())
}
